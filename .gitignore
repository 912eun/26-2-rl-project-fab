# 화이트리스트 방식: 아래에 적은 것만 올린다.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/setup_simulator.sh
!/src/
!/baselines/
!/calibration/
!/experiments/
!/notebooks/
!/data/
!/docs/
!/results/

__pycache__/
*.pyc
.DS_Store

# data: 공장 도착 기록(압축)과 공장 기준값만. 원본 SMT2020은 setup_simulator.sh로 받는다
/data/*
!/data/records/
!/data/fab_reference/

# docs: 문서 모두 (논문 PDF는 저작권·용량 때문에 제외)
/docs/papers/

# experiments, notebooks: 실험·EDA 스크립트 모두 (재현용. 지난 판도 보고서가 참조하므로 남긴다)

# results: 최종(v4) 모델과 결과 요약만
/results/*
!/results/rl_dqn/
!/results/rl_ppo/
/results/rl_dqn/*
/results/rl_ppo/*
!/results/rl_dqn/dqn_*_v4_s*.pt
!/results/rl_dqn/result_*_v4_s*.json
!/results/rl_ppo/ppo_*_v4_s*.pt
!/results/rl_ppo/result_*_v4_s*.json
# 실험 안내서(docs/EXPERIMENT_PLAN.md) 태그 _e<번호>... 의 모델과 결과, 시험 평가 결과
!/results/rl_dqn/dqn_*_e[0-9]*_s*.pt
!/results/rl_dqn/result_*_e[0-9]*_s*.json
!/results/rl_ppo/ppo_*_e[0-9]*_s*.pt
!/results/rl_ppo/result_*_e[0-9]*_s*.json
!/results/eval/
/results/**/*_last.pt
